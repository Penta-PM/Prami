# Prami 조달 수집기 env 파일 예시 — 복사해서 채운다 (런북 docs/ops/collector.md §3.3)
#   mkdir -p -m 700 ~/.config/prami-collector
#   install -m 600 collector/ops/collector.env.example ~/.config/prami-collector/collector.env
# 저장소 밖에만 두고 권한은 600. 실제 값을 저장소·PR·채팅·메일·로그·보고에 쓰지 않는다.
# systemd EnvironmentFile 형식: 한 줄에 KEY=값, export 없음. 값에 공백·$·따옴표·역슬래시가 있으면 작은따옴표로 감싼다.

# 필수 — LAN DB (기존 LAN DB 계정, search_path 는 procurement)
COLLECTOR_DATABASE_URL=postgres://<DB 사용자>:<DB 비밀번호>@<DB 호스트>:5432/<DB 이름>?options=-csearch_path%3Dprocurement

# 필수 — 원본 수집기의 참조·설정 디렉터리를 제자리에서 읽는다 (기밀, 복사하지 않는다)
JODAL_REF_DIR=<원본 수집기>/plan/reference
JODAL_CONFIG_DIR=<원본 수집기>/plan

# 시각 (로그·타이머용)
TZ=Asia/Seoul

# 메일 (Q-C1: 공용 메일함 계정을 나중에 받는다) — 비워 두면 메일을 보내지 않고 job_runs.summary.mail = skipped_no_smtp
JODAL_SMTP_HOST=
JODAL_SMTP_PORT=
JODAL_SMTP_USER=
JODAL_SMTP_PASSWORD=
# 메일 본문의 대시보드 링크 (예: http://<LAN 호스트>:3000/procurement)
JODAL_DASHBOARD_URL=

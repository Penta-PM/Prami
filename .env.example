# 로컬 실행용 환경변수 예시 (스펙 §4.9.2 키 전부, 값은 비움).
# 실제 값은 .env.local 에만 두고 절대 커밋하지 않습니다. 검증 규칙은 src/env.ts 를 참고하세요.
# 빈 값은 "미설정"으로 취급되며, PR-0 에서는 필수 값이 없습니다.

# 앱이 노출되는 공개 URL (미설정 시 http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# ── DB (§4.9) ─────────────────────────────────────────────────────────────
# 드라이버: neon | pg | pglite  (로컬 개발 pg = docker compose, 단위·통합 테스트 pglite, Vercel neon. 미설정 시 pglite)
DB_DRIVER=
# pg / neon 일 때 필수. 로컬 docker compose 기본값: postgres://prami:prami@localhost:5432/prami
DATABASE_URL=
# pglite 데이터 위치 (테스트는 memory://)
PGLITE_DATA_DIR=

# ── 인증 (§4.6.1, Auth.js v5 Google 로그인) ───────────────────────────────
# 32자 이상 임의 문자열 (예: `openssl rand -base64 32`)
AUTH_SECRET=
AUTH_URL=
# Google Cloud 콘솔 OAuth 클라이언트 (리다이렉트 URI: {origin}/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# true 이면 Playwright 용 Credentials 로그인 활성화 (production 에서는 거부됨). true 일 때 AUTH_TEST_PASSWORD 필수
# ⚠ 로컬 전용. Vercel(VERCEL_ENV 정의) 환경에서는 기동 거부. dev 서버를 LAN 에 열 때는 반드시 끌 것
AUTH_TEST_MODE=
AUTH_TEST_PASSWORD=
# 테스트 로그인을 받을 Host (쉼표 구분, 미설정 시 localhost,127.0.0.1). 밖이면 거부 + 감사 auth.denied_test_mode
AUTH_TEST_ALLOWED_HOSTS=
# VERCEL_ENV 환경에서도 테스트 모드를 허용 (비공개 배포 예외 전용, 미설정 시 false)
AUTH_TEST_MODE_ALLOW_REMOTE=
# 로그인 허용 이메일 도메인 (쉼표 구분, 미설정 시 pentasecurity.com)
ALLOWED_EMAIL_DOMAINS=
# 최초 로그인 시 ADMIN 으로 부트스트랩할 이메일 (쉼표 구분)
ADMIN_EMAILS=
# 도메인 검사를 통과한 미등록 사용자를 USER 로 자동 생성 (미설정 시 true)
AUTH_AUTO_PROVISION=

# ── 요청 출처 ─────────────────────────────────────────────────────────────
# 감사 로그 IP 신뢰 모드: none(기본, 위조 가능한 헤더 미사용) | vercel(x-vercel-forwarded-for → x-real-ip) | generic(x-real-ip → XFF 오른쪽 끝)
TRUST_PROXY_HEADERS=

# ── rate limit (§4.8 r6) ─────────────────────────────────────────────────
# 엔드포인트별 키(사용자/IP)당 분당 상한 (미설정 시 30). 인스턴스 메모리 기준 — docs/deploy/vercel.md 참고
RATE_LIMIT_PER_MIN=

# ── 임포트 ───────────────────────────────────────────────────────────────
# QA 전용 실패 주입 (items|manual|load|recompute|verify). production 에서는 기동 거부
IMPORT_FAULT_INJECTION=

# ── PRAMI-002 LLM 챗봇 · 사용자 자격 증명 (§4.13) ─────────────────────────
# 챗봇 LLM 경로 킬스위치 / 규칙 폴백 (미설정 시 true / true)
CHAT_LLM_ENABLED=
CHAT_RULE_FALLBACK=
# ⚠ 시크릿. 사용자 LLM 키 봉투 암호화 KEK 키링 "버전:base64(32바이트)" 쉼표 나열 — 실제 값은 .env.local·Vercel 에만.
#   생성: openssl rand -base64 32  (preview·production 은 서로 다른 KEK)
LLM_CREDENTIALS_KEKS=
# 새 암호화에 쓸 KEK 버전 (KEKS 에 있어야 함)
LLM_CREDENTIALS_ACTIVE_KEK=
# 출력 토큰 / 모델 타임아웃(ms) / 요청당 도구 호출 / 히스토리 턴 (PR-B)
#   출력 토큰은 보이는 답 상한 — OpenAI 추론 모델은 여기에 추론 여유 8192 를 더해 보낸다 (PRAMI-003 L-3, 기본 9216)
CHAT_LLM_MAX_OUTPUT_TOKENS=
CHAT_LLM_TIMEOUT_MS=
CHAT_LLM_MAX_TOOL_CALLS=
CHAT_HISTORY_MAX_TURNS=
# 키 검증 사용자당 분당 상한 (미설정 시 5)
LLM_VERIFY_PER_MIN=
# live | fake (fake = 가짜 검증기, 테스트·QA 전용 — production·VERCEL_ENV 에서 기동 거부)
LLM_VENDOR_MODE=
# OpenRouter OAuth 연결 (PR-C, 미설정 시 false)
LLM_OAUTH_OPENROUTER=
# 외부 트레이싱 — production·VERCEL_ENV 에서 켜면 기동 거부 (대화·도구 결과 반출 금지)
LANGSMITH_TRACING=
LANGCHAIN_TRACING_V2=
